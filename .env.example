# Discord Configuration
DISCORD_TOKEN=""

# OpenAI API Configuration (unified - works with OpenAI, Ollama, or any OpenAI-compatible API)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Vision (Image) Support
OPENAI_VISION_ENABLED=true
OPENAI_VISION_MAX_IMAGES=4

# Logging Configuration
LOG_LEVEL="INFO"
DEBUG=false

# Chat System Prompt
CHAT_SYSTEM_PROMPT="Tu es un bot Discord amical, intelligent et utile. Réponds de manière concise, claire et bienveillante. Utilise le français si la conversation est en français."
